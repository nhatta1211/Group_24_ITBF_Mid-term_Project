# .env.example
# ─────────────────────────────────────────────────────
# This is a TEMPLATE file. It is safe to commit to Git.
# Do NOT put real API keys here.
#
# Setup instructions:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your real API keys in .env
#   3. Never commit .env to Git
# ─────────────────────────────────────────────────────

# Groq API key — used for LLM analysis (Module 4)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Alpha Vantage API key — used for Federal Funds Rate data (Module 1)
# Get your free key at: https://www.alphavantage.co/support/#api-key
# Note: Free tier is limited to 25 requests/day.
# If this key is missing, Fed rate features are skipped gracefully.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
