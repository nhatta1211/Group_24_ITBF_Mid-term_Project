# =============================================================================
# .gitignore — AI-Powered Financial Data Agent
# =============================================================================
# Files and folders listed here are NEVER committed to Git.
# This protects API keys, keeps the repo clean, and prevents
# accidentally uploading gigabytes of virtual environment files.
# =============================================================================

# --- SECRET FILES — NEVER COMMIT THESE ---
# Your Groq API key lives here. If committed, anyone can use your account.
.env
.env.local
.env.*.local

# --- VIRTUAL ENVIRONMENT ---
# The my_env/ folder contains all installed packages (~hundreds of MB).
# Graders install these themselves via: pip install -r requirements.txt
my_env/
venv/
.venv/
env/

# --- PYTHON CACHE FILES ---
# Auto-generated by Python when running code. Not part of the project.
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- GENERATED OUTPUT (optional — remove these lines to track outputs) ---
# Uncomment the lines below if you do NOT want to commit generated files.
# Leave them commented if you want graders to see your output files.
# data/
# output/
# charts/

# --- IDE & EDITOR FILES ---
# VS Code workspace settings (personal preferences, not project config)
.vscode/
*.code-workspace

# PyCharm
.idea/

# --- OPERATING SYSTEM FILES ---
# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble

# --- JUPYTER NOTEBOOKS (if any) ---
.ipynb_checkpoints/

# --- DISTRIBUTION / BUILD ---
dist/
build/
*.egg-info/

# --- COVERAGE & TEST REPORTS ---
.coverage
htmlcov/
.pytest_cache/

